@page "/"
@using System.Net.Http.Json
@using BlazorPokeApi.Models
@inject HttpClient Http

<PageTitle>Buscar Pokémon</PageTitle>

<h3>Buscar Pokémon</h3>

<div class="mb-3">
    <label for="pokemonInput" class="form-label">Nome do Pokémon:</label>
    <input id="pokemonInput" 
           type="text" 
           class="form-control mb-2" 
           @bind="nomePokemon" 
           placeholder="Ex: pikachu, ditto" />
    
    <button class="btn btn-primary" @onclick="BuscarPokemon">Buscar Pokémon</button>
</div>

<hr />

@if (carregando)
{
    <p><em>Carregando...</em></p>
}
else if (!string.IsNullOrEmpty(mensagemErro))
{
    <div class="alert alert-danger">@mensagemErro</div>
}
else if (pokemon != null)
{
    <h4>Detalhes do Pokémon</h4>

    @if (!string.IsNullOrEmpty(pokemon.Sprites?.Other?.OfficialArtwork?.FrontDefault))
    {
        <img src="@pokemon.Sprites.Other.OfficialArtwork.FrontDefault" 
             alt="@pokemon.Name" 
             style="width: 150px; height: 150px; object-fit: contain;" 
             class="mb-3" />
    }

    <p><strong>ID:</strong> @pokemon.Id</p>
    <p><strong>Nome:</strong> @pokemon.Name</p>
    <p><strong>Altura:</strong> @(pokemon.Height / 10) m</p>
    <p><strong>Peso:</strong> @(pokemon.Weight / 10) kg</p>
}

@code {
    private string nomePokemon = string.Empty;
    private Pokemon? pokemon;
    private string mensagemErro = string.Empty;
    private bool carregando = false;

    private async Task BuscarPokemon()
    {
        if (string.IsNullOrWhiteSpace(nomePokemon))
        {
            mensagemErro = "Por favor, digite o nome de um Pokémon.";
            pokemon = null;
            return;
        }

        try
        {
            carregando = true;
            mensagemErro = string.Empty;
            pokemon = null;

            // A PokéAPI exige que o nome na URL esteja em letras minúsculas
            string endpoint = $"https://pokeapi.co/api/v2/pokemon/{nomePokemon.Trim().ToLower()}";
            pokemon = await Http.GetFromJsonAsync<Pokemon>(endpoint);
        }
        catch (Exception)
        {
            mensagemErro = "Pokémon não encontrado ou erro ao conectar com a API.";
            pokemon = null;
        }
        finally
        {
            carregando = false;
        }
    }
}
